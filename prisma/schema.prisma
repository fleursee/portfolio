// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
// URL would be here, but because its deprecated, it will be in prisma.config.ts


// Object representing a [personal] project
model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  image       String?  // URL to screenshot
  tags        String[] // e.g., ["React", "Next.js"]
  category    String?  // "Frontend", "Fullstack"
  githubUrl   String?
  liveUrl     String?
  content     String?  // MD for detail page
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// Object representing a coding skill
model Skill {
  id        String @id @default(cuid())
  name      String
  category  String // e.g., "Frontend", "Backend"
}

// Object representing a blog post (whenever I want to write a blog post)
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String   // MDX
  tags        String[]
  published   Boolean  @default(false)
  publishedAt DateTime?
  readingTime Int?
  createdAt   DateTime @default(now())
}
